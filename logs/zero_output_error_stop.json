{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ZeroOutputErrorStop",
  "description": "Comprehensive sovereign type-safe schema optimized for circuit breaker failure state validation.",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ZERO_OUTPUT_COMMITTED_ERROR"],
      "description": "Critical system execution status indicator."
    },
    "errorCode": {
      "type": "string",
      "enum": ["ERR_ZERO_OUTPUT_CIRCUIT_BREAKER"],
      "description": "Standardized machine-readable error classification code."
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "Originating component or execution context identifier."
    },
    "payloadBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 0,
      "description": "Strictly bound payload byte size confirming zero output condition."
    },
    "cycle": {
      "type": "integer",
      "minimum": 0,
      "description": "Execution cycle counter."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 high-precision event logging timestamp."
    },
    "systemHalted": {
      "type": "boolean",
      "enum": [true],
      "description": "Hard-stop verification flag."
    },
    "haltReason": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable diagnostic trace of the trip event."
    },
    "repository": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+@[a-zA-Z0-9_.-]+$",
      "description": "Target repository coordinates and reference."
    }
  },
  "required": [
    "status",
    "errorCode",
    "source",
    "payloadBytes",
    "cycle",
    "timestamp",
    "systemHalted",
    "haltReason",
    "repository"
  ],
  "additionalProperties": false,
  "status": "ZERO_OUTPUT_COMMITTED_ERROR",
  "errorCode": "ERR_ZERO_OUTPUT_CIRCUIT_BREAKER",
  "source": "Manual_Dashboard_Circuit_Breaker_Test",
  "payloadBytes": 0,
  "cycle": 7,
  "timestamp": "2026-08-21T01:49:31.410Z",
  "systemHalted": true,
  "haltReason": "ZERO OUTPUT COMMITTED BY [Manual_Dashboard_Circuit_Breaker_Test] (0 Bytes) - EMERGENCY SYSTEM STOP TRIPPED",
  "repository": "craighckby-stack/Gemini-Code-enhancer@main"
}